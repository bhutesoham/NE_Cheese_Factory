# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/kaaswinkel

# Authentication (generate a strong random string, e.g. run: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Admin account (set these before first run)
ADMIN_EMAIL=admin@yourshop.nl
ADMIN_PASSWORD=your-secure-admin-password

# Email (Resend.com - free tier: 3000 emails/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxx
FROM_EMAIL=bestellingen@yourshop.nl
ADMIN_EMAIL_NOTIFY=admin@yourshop.nl

# App URL (change for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shop info
NEXT_PUBLIC_SHOP_NAME=De Kaaswinkel
NEXT_PUBLIC_SHOP_EMAIL=info@yourshop.nl
NEXT_PUBLIC_SHOP_PHONE=+31 6 12345678
